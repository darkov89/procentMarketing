# Lead Machine 2.0 - Konfiguracja Środowiska (.env)
# Skopiuj do .env lub web/.env.local i uzupełnij właściwe klucze. Nigdy nie commituj sekretów!

# 1. Baza Danych & Szyfrowanie (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:twoje_haslo@ep-twoj-endpoint-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_MIGRATIONS=postgresql://neondb_owner:twoje_haslo@ep-twoj-endpoint.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Klucz szyfrowania danych poufnych tenantów (AES-256-GCM, 32 bajty base64)
SECRETS_ENCRYPTION_KEY=twoj_klucz_32_bajty_base64

# 2. Inwarianty Bezpieczeństwa (AGENTS.md)
# Domyślnie false. W trybie testowym wiadomości trafiają wyłącznie do TEST_RECIPIENTS z prefiksem [TEST].
LIVE_MODE=false
# Wymóg zatwierdzenia przez człowieka (EU AI Act art. 14): 'all' lub 'batches'
APPROVAL_MODE=all
TEST_RECIPIENTS=twoj-email-do-testow@example.com
# Awaryjny wyłącznik (obecność tego pliku natychmiast blokuje wysyłkę)
KILL_SWITCH_FILE=STOP

# 3. Aplikacja & Automatyzacja (Vercel)
NEXT_PUBLIC_APP_NAME="Procent Marketing Lead Machine"
NEXT_PUBLIC_APP_URL=https://procent-marketing.vercel.app
# Sekret autoryzacyjny dla endpointów cyklicznych (/api/cron/tick, worker)
CRON_SECRET=twoj_losowy_tajny_token_cron

# 4. Sztuczna Inteligencja & Pozyskiwanie Leadów (Opcjonalne)
GEMINI_API_KEY=twoj_klucz_gemini_api
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_MAPS_API_KEY=twoj_klucz_google_places_api

# 5. Domyślny Profil Nadawcy (Fallback, gdy tenant nie ma skonfigurowanej skrzynki w UI)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kontakt@twoja-domena.pl
SMTP_PASSWORD=twoje_haslo_lub_app_password
SMTP_FROM_NAME="Procent Marketing"
SMTP_FROM_EMAIL=kontakt@twoja-domena.pl

# Opcjonalny kod master do rejestracji administratora (pozostaw puste dla trybu zamkniętego)
BOOTSTRAP_INVITE_CODE=
