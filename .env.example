# Lead Machine - Konfiguracja Środowiska (.env)
# Skopiuj do .env / .env.local i uzupełnij właściwe klucze. Nigdy nie commituj sekretów!

# 1. Baza Danych (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:twoje_haslo@ep-twoj-endpoint.eu-central-1.aws.neon.tech/neondb?sslmode=require

# 2. Tryb Działania (BEZPIECZEŃSTWO & GO-LIVE)
# Domyślnie false. W trybie testowym wiadomości trafiają wyłącznie do TEST_RECIPIENTS z prefiksem [TEST].
LIVE_MODE=false
TEST_RECIPIENTS=twoj-email-do-testow@example.com
# Opcjonalna ścieżka do pliku kill-switch (domyślnie "STOP" w katalogu roboczym)
KILL_SWITCH_FILE=STOP

# 3. Model Gemini (Structured Outputs, ekstrakcja twierdzeń, scoring)
GEMINI_API_KEY=twoj_klucz_gemini_api
GEMINI_MODEL=gemini-2.5-flash

# 4. Google APIs (Geolokalizacja, Google Places New v1)
GOOGLE_MAPS_API_KEY=twoj_klucz_google_places_api

# 5. Wysyłka Poczty (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kontakt@twoja-domena-wysylkowa.pl
SMTP_PASSWORD=twoje_haslo_lub_app_password
SMTP_FROM_NAME="Dariusz - Procent Marketing"
SMTP_FROM_EMAIL=kontakt@twoja-domena-wysylkowa.pl

# 6. Odbiór Poczty / Monitor Odpowiedzi (IMAP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=kontakt@twoja-domena-wysylkowa.pl
IMAP_PASSWORD=twoje_haslo_lub_app_password

# 7. Bezpieczeństwo i Autoryzacja
# Kod początkowej rejestracji administratora (opcjonalny - brak wartości blokuje otwartą rejestrację)
BOOTSTRAP_INVITE_CODE=
# Klucz szyfrowania danych poufnych (AES-256-GCM, 32 bajty base64)
SECRETS_ENCRYPTION_KEY=
# Sekret autoryzacyjny dla endpointów cyklicznych (/api/cron/tick, worker)
CRON_SECRET=
# Bazowy adres URL aplikacji (np. https://app.procentmarketing.pl lub http://localhost:3000)
APP_BASE_URL=http://localhost:3000
