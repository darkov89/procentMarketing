# Lead Machine - Konfiguracja Środowiska (.env)
# Skopiuj do .env i uzupełnij właściwe klucze. Nigdy nie commituj pliku .env!

# 1. Tryb Działania (BEZPIECZEŃSTWO)
LIVE_MODE=false
TEST_RECIPIENTS=twoj-email-do-testow@example.com

# 2. Baza Danych
DATABASE_URL=sqlite:///leadmachine.db

# 3. Model Gemini (Structured Outputs & Scoring)
GEMINI_API_KEY=twoj_klucz_gemini_api
GEMINI_MODEL=gemini-2.5-flash

# 4. Wysyłka Poczty (SMTP / Google Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kontakt@twoja-domena-wysylkowa.pl
SMTP_PASSWORD=haslo_lub_app_password
SMTP_FROM_NAME="Dariusz - Procent Marketing"
SMTP_FROM_EMAIL=kontakt@twoja-domena-wysylkowa.pl

# 5. Odbiór Poczty / Monitor Skrzynki (IMAP / Gmail API)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=kontakt@twoja-domena-wysylkowa.pl
IMAP_PASSWORD=haslo_lub_app_password

# 6. Publikacja Ofert (Netlify)
NETLIFY_AUTH_TOKEN=twoj_netlify_personal_access_token
NETLIFY_SITE_ID=twoj_netlify_site_id
NETLIFY_BASE_URL=https://oferta.twoja-domena.pl

# 7. Zewnętrzne Rejestry (CEIDG / REGON) - Opcjonalne
CEIDG_API_TOKEN=
REGON_USER_KEY=

# 8. Powiadomienia (Telegram Bot - Opcjonalne)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 9. Bramki SMS / WhatsApp (Domyślnie wyłączone przez ChannelGate)
SMSAPI_TOKEN=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
